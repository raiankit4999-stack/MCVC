{
  "name": "mcvc",
  "private": true,
  "description": "Computer Community Network — multi-tenant SaaS for computer retail & IT service businesses",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @mcvc/api test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @mcvc/api db:migrate",
    "db:seed": "pnpm --filter @mcvc/api db:seed"
  }
}
