# Alternative to nginx when Caddy fronts the VPS. Caddy issues certificates automatically,
# including for store custom domains, but only after asking the API whether the domain is verified.
{
    on_demand_tls {
        ask http://127.0.0.1:4100/api/v1/internal/domains/tls-check
    }
}

pccommunity.in, www.pccommunity.in {
    reverse_proxy 127.0.0.1:3100
}

# Platform subdomains and verified custom domains.
https:// {
    tls {
        on_demand
    }
    reverse_proxy 127.0.0.1:3100
}
