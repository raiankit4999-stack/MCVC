# Copy to deploy/.env and fill in. Generate secrets with: openssl rand -base64 48

# Main community website domain (no https://)
COMMUNITY_HOST=canetwork.in
# Stores get <slug>.<PLATFORM_DOMAIN> automatically (needs wildcard DNS *.PLATFORM_DOMAIN → this VPS)
PLATFORM_DOMAIN=stores.canetwork.in
# Store owners point their custom domain's CNAME here (A record for apex domains)
DOMAIN_CNAME_TARGET=stores.canetwork.in

POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Super admin created on first start (password: 12+ characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local ports (bound to 127.0.0.1 only). Change if another app already uses them.
WEB_PORT=3100
API_PORT=4100

# Demo data (TechWorld demo store + Computer Association of Nadiad member listings).
# Set SEED_DEMO=true for a demo server; the demo store owner logs in as owner@techworld.local with SEED_PASSWORD.
SEED_DEMO=false
SEED_PASSWORD=
# Show one-tap demo logins on /login (admin@demo.can, manager.nadiad@demo.can, owner@demo.can,
# cashier@demo.can, technician@demo.can — password CanDemo@2026). Never enable on a live network.
DEMO_MODE=false
