# Copy to deploy/.env and fill in. Generate secrets with: openssl rand -base64 48

# Main community website domain (no https://)
COMMUNITY_HOST=pccommunity.in
# Stores get <slug>.<PLATFORM_DOMAIN> automatically (needs wildcard DNS *.PLATFORM_DOMAIN → this VPS)
PLATFORM_DOMAIN=stores.pccommunity.in
# Store owners point their custom domain's CNAME here (A record for apex domains)
DOMAIN_CNAME_TARGET=stores.pccommunity.in

POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Super admin created on first start (password: 12+ characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local ports (bound to 127.0.0.1 only). Change if another app already uses them.
WEB_PORT=3100
API_PORT=4100
