// Computer Community Network — core data model.
//
// Conventions
// - Every tenant-owned business record carries `storeId` and is protected by
//   PostgreSQL Row-Level Security (see migrations/*_rls). The API also scopes
//   every query by storeId (defence in depth).
// - Timestamps are stored in UTC (timestamptz); stores declare a timezone for display.
// - Money is NUMERIC(14,2) in INR. Calculations happen in integer paise in code.
// - Financial documents are never hard-deleted; corrections use reversal records
//   (credit notes, reversal stock movements, refund payments).
// - Important records use soft deletion (`deletedAt`).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Platform & community ─────────────────────────────

model Community {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  tagline   String?
  logoUrl   String?
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  cities       City[]
  stores       Store[]
  categories   BusinessCategory[]
  plans        MembershipPlan[]
  applications MembershipApplication[]
  announcements Announcement[]

  @@map("communities")
}

model City {
  id          String   @id @default(uuid()) @db.Uuid
  communityId String   @db.Uuid
  name        String
  slug        String
  state       String
  stateCode   String   @db.VarChar(2) // GST state code, e.g. "24" for Gujarat
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  community Community @relation(fields: [communityId], references: [id])
  areas     Area[]
  stores    Store[]
  scopes    AdminScope[]

  @@unique([communityId, slug])
  @@map("cities")
}

model Area {
  id         String   @id @default(uuid()) @db.Uuid
  cityId     String   @db.Uuid
  name       String
  slug       String
  postalCode String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  city   City         @relation(fields: [cityId], references: [id])
  stores Store[]
  scopes AdminScope[]

  @@unique([cityId, slug])
  @@map("areas")
}

model BusinessCategory {
  id          String  @id @default(uuid()) @db.Uuid
  communityId String  @db.Uuid
  parentId    String? @db.Uuid
  name        String
  slug        String
  kind        CategoryKind @default(PRODUCT)
  sortOrder   Int     @default(0)

  community Community          @relation(fields: [communityId], references: [id])
  parent    BusinessCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  BusinessCategory[] @relation("CategoryTree")
  stores    StoreCategory[]

  @@unique([communityId, slug])
  @@map("business_categories")
}

enum CategoryKind {
  PRODUCT
  SERVICE
}

model MembershipPlan {
  id           String   @id @default(uuid()) @db.Uuid
  communityId  String   @db.Uuid
  code         String
  name         String
  description  String?
  priceMonthly Decimal  @db.Decimal(14, 2)
  priceYearly  Decimal  @db.Decimal(14, 2)
  features     String[] // feature keys, e.g. "website", "crm", "erp", "staff", "analytics"
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)

  community     Community      @relation(fields: [communityId], references: [id])
  subscriptions Subscription[]
  applications  MembershipApplication[]

  @@unique([communityId, code])
  @@map("membership_plans")
}

/// Membership approval (community decision) is intentionally separate from
/// the SaaS subscription state (billing).
model MembershipApplication {
  id            String            @id @default(uuid()) @db.Uuid
  communityId   String            @db.Uuid
  applicantId   String            @db.Uuid
  businessName  String
  ownerName     String
  phone         String
  email         String
  gstin         String?
  addressLine   String
  cityId        String            @db.Uuid
  areaId        String            @db.Uuid
  categoryIds   String[]
  planId        String            @db.Uuid
  documents     Json              @default("[]")
  status        ApplicationStatus @default(PENDING)
  reviewNote    String?
  reviewedById  String?           @db.Uuid
  reviewedAt    DateTime?         @db.Timestamptz(6)
  storeId       String?           @unique @db.Uuid
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)

  community Community      @relation(fields: [communityId], references: [id])
  applicant User           @relation("ApplicationApplicant", fields: [applicantId], references: [id])
  plan      MembershipPlan @relation(fields: [planId], references: [id])

  @@index([status, cityId])
  @@map("membership_applications")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Store {
  id             String           @id @default(uuid()) @db.Uuid
  communityId    String           @db.Uuid
  cityId         String           @db.Uuid
  areaId         String           @db.Uuid
  name           String
  slug           String           @unique
  legalName      String?
  gstin          String?
  stateCode      String           @db.VarChar(2)
  phone          String
  email          String
  addressLine    String
  latitude       Float?
  longitude      Float?
  timezone       String           @default("Asia/Kolkata")
  membershipStatus MembershipStatus @default(ACTIVE)
  websiteStatus  WebsiteStatus    @default(DRAFT)
  isVerified     Boolean          @default(false)
  isFeatured     Boolean          @default(false)
  ratingAverage  Decimal          @default(0) @db.Decimal(3, 2)
  ratingCount    Int              @default(0)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?        @db.Timestamptz(6)

  community     Community       @relation(fields: [communityId], references: [id])
  city          City            @relation(fields: [cityId], references: [id])
  area          Area            @relation(fields: [areaId], references: [id])
  categories    StoreCategory[]
  domains       StoreDomain[]
  settings      StoreSettings?
  subscriptions Subscription[]
  members       StoreUser[]
  roles         StoreRole[]

  @@index([cityId, areaId, membershipStatus])
  @@map("stores")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum WebsiteStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

model StoreCategory {
  storeId    String @db.Uuid
  categoryId String @db.Uuid

  store    Store            @relation(fields: [storeId], references: [id])
  category BusinessCategory @relation(fields: [categoryId], references: [id])

  @@id([storeId, categoryId])
  @@map("store_categories")
}

model StoreDomain {
  id                 String             @id @default(uuid()) @db.Uuid
  storeId            String             @db.Uuid
  hostname           String             @unique
  isPrimary          Boolean            @default(false)
  verificationToken  String
  verificationStatus DomainVerification @default(PENDING)
  verifiedAt         DateTime?          @db.Timestamptz(6)
  lastCheckedAt      DateTime?          @db.Timestamptz(6)
  sslStatus          SslStatus          @default(PENDING)
  redirectToPrimary  Boolean            @default(true)
  expiresAt          DateTime?          @db.Timestamptz(6) // registrar renewal date, entered by owner
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("store_domains")
}

enum DomainVerification {
  PENDING
  VERIFIED
  FAILED
  SUSPENDED
}

enum SslStatus {
  PENDING
  ACTIVE
  FAILED
}

model StoreSettings {
  storeId        String   @id @db.Uuid
  logoUrl        String?
  faviconUrl     String?
  tagline        String?
  about          String?
  heroImageUrl   String?
  heroHeadline   String?
  primaryColor   String   @default("#2563EB")
  accentColor    String   @default("#172B4D")
  fontPreset     String   @default("inter")
  whatsappNumber String?
  socialLinks    Json     @default("{}")
  businessHours  Json     @default("[]")
  footerText     String?
  seoTitle       String?
  seoDescription String?
  invoicePrefix  String   @default("INV")
  jobCardPrefix  String   @default("JC")
  invoiceTerms   String?
  /// GST rates (percent) this store may use. Must be validated by a tax professional.
  allowedGstRates Decimal[] @default([0, 0.25, 3, 5, 12, 18, 28, 40]) @db.Decimal(5, 2)
  bookingSlotMinutes Int  @default(60)
  bookingSlotCapacity Int @default(2)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id])

  @@map("store_settings")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  storeId            String             @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY)
  currentPeriodStart DateTime           @db.Timestamptz(6)
  currentPeriodEnd   DateTime           @db.Timestamptz(6)
  gatewayRef         String?
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)

  store Store          @relation(fields: [storeId], references: [id])
  plan  MembershipPlan @relation(fields: [planId], references: [id])

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Announcement {
  id          String   @id @default(uuid()) @db.Uuid
  communityId String   @db.Uuid
  title       String
  body        String
  publishedAt DateTime @default(now()) @db.Timestamptz(6)

  community Community @relation(fields: [communityId], references: [id])

  @@map("announcements")
}

// ───────────────────────────── Identity & access ─────────────────────────────

model User {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  phone         String?       @unique
  name          String
  passwordHash  String
  platformRole  PlatformRole?
  mfaEnabled    Boolean       @default(false)
  isActive      Boolean       @default(true)
  lastLoginAt   DateTime?     @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)

  sessions     Session[]
  memberships  StoreUser[]
  scopes       AdminScope[]
  applications MembershipApplication[] @relation("ApplicationApplicant")

  @@map("users")
}

/// Community-level staff roles. Store-level roles live in StoreRole.
enum PlatformRole {
  SUPER_ADMIN
  COMMUNITY_ADMIN
  CITY_MANAGER
  AREA_MANAGER
}

/// Geographic scope for CITY_MANAGER / AREA_MANAGER users.
model AdminScope {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @db.Uuid
  cityId String? @db.Uuid
  areaId String? @db.Uuid

  user User  @relation(fields: [userId], references: [id])
  city City? @relation(fields: [cityId], references: [id])
  area Area? @relation(fields: [areaId], references: [id])

  @@index([userId])
  @@map("admin_scopes")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime  @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model StoreRole {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @db.Uuid
  name        String
  permissions String[]
  isSystem    Boolean  @default(false)

  store   Store       @relation(fields: [storeId], references: [id])
  members StoreUser[]

  @@unique([storeId, name])
  @@map("store_roles")
}

model StoreUser {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  store Store     @relation(fields: [storeId], references: [id])
  user  User      @relation(fields: [userId], references: [id])
  role  StoreRole @relation(fields: [roleId], references: [id])

  @@unique([storeId, userId])
  @@map("store_users")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @db.Uuid // storeId for store actions, null for community actions
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ───────────────────────────── Store operations (tenant-owned) ─────────────────────────────

model DocumentSequence {
  storeId       String @db.Uuid
  docType       String
  financialYear String // e.g. "2026-27"
  nextValue     Int    @default(1)

  @@id([storeId, docType, financialYear])
  @@map("document_sequences")
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  storeId   String    @db.Uuid
  name      String
  phone     String
  email     String?
  gstin     String?
  stateCode String?   @db.VarChar(2)
  address   String?
  group     String?
  notes     String?
  marketingConsent Boolean @default(false)
  consentAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  invoices   Invoice[]
  bookings   Booking[]
  repairJobs RepairJob[]

  @@unique([storeId, phone])
  @@index([storeId, name])
  @@index([storeId, email])
  @@map("customers")
}

model Lead {
  id         String     @id @default(uuid()) @db.Uuid
  storeId    String     @db.Uuid
  customerId String?    @db.Uuid
  name       String
  phone      String
  email      String?
  source     String     @default("website")
  message    String?
  status     LeadStatus @default(NEW)
  followUpAt DateTime?  @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)

  @@index([storeId, status])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model ProductCategory {
  id      String  @id @default(uuid()) @db.Uuid
  storeId String  @db.Uuid
  name    String

  products Product[]

  @@unique([storeId, name])
  @@map("product_categories")
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  storeId        String    @db.Uuid
  categoryId     String?   @db.Uuid
  sku            String
  barcode        String?
  name           String
  brand          String?
  modelNumber    String?
  mpn            String?
  description    String?
  imageUrl       String?
  hsnCode        String
  gstRate        Decimal   @db.Decimal(5, 2)
  mrp            Decimal   @db.Decimal(14, 2)
  purchasePrice  Decimal   @db.Decimal(14, 2)
  sellingPrice   Decimal   @db.Decimal(14, 2)
  warrantyMonths Int       @default(0)
  reorderLevel   Int       @default(0)
  unit           String    @default("NOS")
  isSerialized   Boolean   @default(false)
  condition      ProductCondition @default(NEW)
  specs          Json      @default("{}") // processor, ram, storage, gpu, screenSize, os ...
  stockOnHand    Int       @default(0)
  isPublished    Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime? @db.Timestamptz(6)

  category  ProductCategory? @relation(fields: [categoryId], references: [id])
  serials   ProductSerial[]
  movements StockMovement[]

  @@unique([storeId, sku])
  @@index([storeId, barcode])
  @@index([storeId, name])
  @@map("products")
}

enum ProductCondition {
  NEW
  REFURBISHED
  USED
  OPEN_BOX
}

model ProductSerial {
  id            String       @id @default(uuid()) @db.Uuid
  storeId       String       @db.Uuid
  productId     String       @db.Uuid
  serialNumber  String
  imei          String?
  status        SerialStatus @default(IN_STOCK)
  invoiceItemId String?      @db.Uuid
  warrantyStart DateTime?    @db.Timestamptz(6)
  warrantyEnd   DateTime?    @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id])

  @@unique([storeId, serialNumber])
  @@index([storeId, imei])
  @@map("product_serials")
}

enum SerialStatus {
  IN_STOCK
  RESERVED
  SOLD
  RETURNED
  DAMAGED
  RMA
}

model InventoryLocation {
  id        String  @id @default(uuid()) @db.Uuid
  storeId   String  @db.Uuid
  name      String
  isDefault Boolean @default(false)

  @@unique([storeId, name])
  @@map("inventory_locations")
}

/// Append-only, auditable ledger of every stock change.
model StockMovement {
  id            String       @id @default(uuid()) @db.Uuid
  storeId       String       @db.Uuid
  productId     String       @db.Uuid
  locationId    String?      @db.Uuid
  movementType  MovementType
  quantity      Int          // signed: +in / -out
  unitCost      Decimal?     @db.Decimal(14, 2)
  referenceType String?      // invoice, purchase, repair_job, adjustment
  referenceId   String?
  note          String?
  createdById   String?      @db.Uuid
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id])

  @@index([storeId, productId, createdAt])
  @@map("stock_movements")
}

enum MovementType {
  OPENING
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGED
  REPAIR_CONSUMPTION
  REVERSAL
}

model Supplier {
  id        String    @id @default(uuid()) @db.Uuid
  storeId   String    @db.Uuid
  name      String
  gstin     String?
  phone     String?
  email     String?
  address   String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  purchases PurchaseOrder[]

  @@index([storeId, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id          String         @id @default(uuid()) @db.Uuid
  storeId     String         @db.Uuid
  supplierId  String         @db.Uuid
  number      String
  status      PurchaseStatus @default(DRAFT)
  supplierInvoiceNo String?
  orderedAt   DateTime       @default(now()) @db.Timestamptz(6)
  receivedAt  DateTime?      @db.Timestamptz(6)
  total       Decimal        @default(0) @db.Decimal(14, 2)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]

  @@unique([storeId, number])
  @@map("purchase_orders")
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseItem {
  id         String  @id @default(uuid()) @db.Uuid
  storeId    String  @db.Uuid
  purchaseId String  @db.Uuid
  productId  String  @db.Uuid
  quantity   Int
  unitCost   Decimal @db.Decimal(14, 2)
  gstRate    Decimal @db.Decimal(5, 2)
  serials    String[]

  purchase PurchaseOrder @relation(fields: [purchaseId], references: [id])

  @@map("purchase_items")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  storeId       String        @db.Uuid
  customerId    String?       @db.Uuid
  docType       InvoiceType   @default(TAX_INVOICE)
  invoiceNumber String
  financialYear String
  issuedAt      DateTime      @default(now()) @db.Timestamptz(6)
  dueAt         DateTime?     @db.Timestamptz(6)
  placeOfSupply String        @db.VarChar(2)
  isInterState  Boolean
  customerSnapshot Json       @default("{}")
  subtotal      Decimal       @db.Decimal(14, 2) // before discount
  discountTotal Decimal       @db.Decimal(14, 2)
  taxableTotal  Decimal       @db.Decimal(14, 2)
  cgstTotal     Decimal       @db.Decimal(14, 2)
  sgstTotal     Decimal       @db.Decimal(14, 2)
  igstTotal     Decimal       @db.Decimal(14, 2)
  roundOff      Decimal       @db.Decimal(14, 2)
  grandTotal    Decimal       @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(14, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  status        InvoiceStatus @default(ISSUED)
  repairJobId   String?       @db.Uuid
  notes         String?
  createdById   String?       @db.Uuid
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)

  customer Customer?     @relation(fields: [customerId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  @@unique([storeId, docType, invoiceNumber])
  @@index([storeId, issuedAt])
  @@index([storeId, customerId])
  @@map("invoices")
}

enum InvoiceType {
  TAX_INVOICE
  BILL_OF_SUPPLY
  QUOTATION
  PROFORMA
  CREDIT_NOTE
  DEBIT_NOTE
  DELIVERY_CHALLAN
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model InvoiceItem {
  id           String   @id @default(uuid()) @db.Uuid
  storeId      String   @db.Uuid
  invoiceId    String   @db.Uuid
  productId    String?  @db.Uuid
  serviceId    String?  @db.Uuid
  description  String
  hsnSac       String
  quantity     Decimal  @db.Decimal(12, 3)
  unitPrice    Decimal  @db.Decimal(14, 2)
  discount     Decimal  @db.Decimal(14, 2)
  taxableValue Decimal  @db.Decimal(14, 2)
  gstRate      Decimal  @db.Decimal(5, 2)
  cgst         Decimal  @db.Decimal(14, 2)
  sgst         Decimal  @db.Decimal(14, 2)
  igst         Decimal  @db.Decimal(14, 2)
  lineTotal    Decimal  @db.Decimal(14, 2)
  unitCost     Decimal  @default(0) @db.Decimal(14, 2) // cost at time of sale, for gross profit
  serialNumbers String[]

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("invoice_items")
}

/// Payments are immutable. Refunds are recorded as negative-amount payments.
model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  storeId     String        @db.Uuid
  invoiceId   String        @db.Uuid
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod
  reference   String?
  receivedAt  DateTime      @default(now()) @db.Timestamptz(6)
  createdById String?       @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([storeId, receivedAt])
  @@map("payments")
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  GATEWAY
}

model Service {
  id              String    @id @default(uuid()) @db.Uuid
  storeId         String    @db.Uuid
  name            String
  slug            String
  description     String?
  sacCode         String    @default("998713")
  gstRate         Decimal   @default(18) @db.Decimal(5, 2)
  price           Decimal   @db.Decimal(14, 2)
  priceIsStarting Boolean   @default(true)
  durationMinutes Int       @default(60)
  isBookable      Boolean   @default(true)
  isPublished     Boolean   @default(true)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  bookings Booking[]

  @@unique([storeId, slug])
  @@map("services")
}

model Employee {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @db.Uuid
  userId      String?  @db.Uuid
  name        String
  phone       String?
  designation String
  isTechnician Boolean @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  repairJobs RepairJob[]
  bookings   Booking[]

  @@index([storeId])
  @@map("employees")
}

/// Capacity counter used for transactional slot reservation.
model BookingSlot {
  id       String   @id @default(uuid()) @db.Uuid
  storeId  String   @db.Uuid
  startsAt DateTime @db.Timestamptz(6)
  capacity Int
  booked   Int      @default(0)

  @@unique([storeId, startsAt])
  @@map("booking_slots")
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  storeId       String        @db.Uuid
  customerId    String        @db.Uuid
  serviceId     String?       @db.Uuid
  technicianId  String?       @db.Uuid
  reference     String
  slotStart     DateTime      @db.Timestamptz(6)
  deviceType    String?
  deviceModel   String?
  problem       String?
  pickupRequired Boolean      @default(false)
  notes         String?
  status        BookingStatus @default(NEW)
  repairJobId   String?       @db.Uuid
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)

  customer   Customer  @relation(fields: [customerId], references: [id])
  service    Service?  @relation(fields: [serviceId], references: [id])
  technician Employee? @relation(fields: [technicianId], references: [id])

  @@unique([storeId, reference])
  @@index([storeId, slotStart])
  @@map("bookings")
}

enum BookingStatus {
  NEW
  PENDING_CONFIRMATION
  CONFIRMED
  RESCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model RepairDevice {
  id           String   @id @default(uuid()) @db.Uuid
  storeId      String   @db.Uuid
  customerId   String   @db.Uuid
  category     String   // laptop, desktop, printer, ...
  brand        String
  model        String
  serialNumber String?
  imei         String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  jobs RepairJob[]

  @@index([storeId, serialNumber])
  @@map("repair_devices")
}

model RepairJob {
  id                String       @id @default(uuid()) @db.Uuid
  storeId           String       @db.Uuid
  customerId        String       @db.Uuid
  deviceId          String       @db.Uuid
  technicianId      String?      @db.Uuid
  jobNumber         String
  status            RepairStatus @default(RECEIVED)
  reportedProblem   String
  physicalCondition String?
  accessories       String[]
  intakePhotos      String[]
  diagnosis         String?
  estimateAmount    Decimal?     @db.Decimal(14, 2)
  labourCharge      Decimal?     @db.Decimal(14, 2)
  finalAmount       Decimal?     @db.Decimal(14, 2)
  approval          RepairApproval @default(NOT_REQUESTED)
  approvalAt        DateTime?    @db.Timestamptz(6)
  estimatedDelivery DateTime?    @db.Timestamptz(6)
  warrantyDays      Int          @default(0)
  trackingTokenHash String       @unique
  deliveredAt       DateTime?    @db.Timestamptz(6)
  createdById       String?      @db.Uuid
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)

  customer   Customer     @relation(fields: [customerId], references: [id])
  device     RepairDevice @relation(fields: [deviceId], references: [id])
  technician Employee?    @relation(fields: [technicianId], references: [id])
  updates    JobUpdate[]
  parts      JobPart[]

  @@unique([storeId, jobNumber])
  @@index([storeId, status])
  @@map("repair_jobs")
}

enum RepairStatus {
  RECEIVED
  DIAGNOSING
  WAITING_FOR_APPROVAL
  WAITING_FOR_PARTS
  IN_PROGRESS
  QUALITY_CHECK
  READY
  DELIVERED
  CANCELLED
}

enum RepairApproval {
  NOT_REQUESTED
  PENDING
  APPROVED
  REJECTED
}

model JobUpdate {
  id          String        @id @default(uuid()) @db.Uuid
  storeId     String        @db.Uuid
  repairJobId String        @db.Uuid
  status      RepairStatus
  note        String?
  isPublic    Boolean       @default(true)
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)

  job RepairJob @relation(fields: [repairJobId], references: [id])

  @@index([repairJobId, createdAt])
  @@map("job_updates")
}

model JobPart {
  id          String  @id @default(uuid()) @db.Uuid
  storeId     String  @db.Uuid
  repairJobId String  @db.Uuid
  productId   String  @db.Uuid
  quantity    Int
  unitPrice   Decimal @db.Decimal(14, 2)

  job RepairJob @relation(fields: [repairJobId], references: [id])

  @@map("job_parts")
}

/// Outbox of customer/staff notifications. A worker delivers queued rows.
model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  storeId     String             @db.Uuid
  channel     NotificationChannel
  recipient   String
  template    String
  payload     Json               @default("{}")
  status      NotificationStatus @default(QUEUED)
  attempts    Int                @default(0)
  lastError   String?
  sentAt      DateTime?          @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("notifications")
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}
