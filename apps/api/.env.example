# PostgreSQL. The app role must NOT be a superuser, otherwise Row-Level Security is bypassed.
DATABASE_URL=postgresql://mcvc:mcvc@localhost:5432/mcvc?schema=public
# Secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Field-level encryption key for sensitive columns (32 bytes, base64)
FIELD_ENCRYPTION_KEY=
# Base domain for platform subdomains: <store-slug>.<PLATFORM_DOMAIN>
PLATFORM_DOMAIN=mcvc.localhost
# Hostnames that serve the community website (comma separated)
COMMUNITY_HOSTS=localhost,mcvc.localhost
# Target that store custom domains must CNAME to
DOMAIN_CNAME_TARGET=stores.mcvc.example
PORT=4000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
